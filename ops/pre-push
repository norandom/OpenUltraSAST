#!/bin/sh
# OpenUltraSAST pre-push safety net. Advisory: nothing here rejects a push unless
# OUSAST_PUSH_MODE=blocking is set explicitly. Install with `ousast pre-push install`
# (or ops/install-pre-push from a checkout); remove with `ousast pre-push uninstall`.
# A prior hook is chained only after it was moved to the sibling path "$0.before-ousast".
artifact_dir=${OUSAST_ARTIFACT_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/openultrasast/push}
prior="$0.before-ousast"
command=${OUSAST_COMMAND:-ousast}
if ! command -v "$command" >/dev/null 2>&1; then
    echo "ousast: pre-push check did not run: '$command' is not on PATH." \
        "Install it with 'pip install openultrasast' or set OUSAST_COMMAND. Push continues."
    if [ -e "$prior" ] || [ -L "$prior" ]; then
        exec "$prior" "$@"
    fi
    exit 0
fi
remote_name=$1
remote_url=$2
set -- pre-push . --artifact "$artifact_dir/push-$$.json" \
    --deadline "${OUSAST_PUSH_DEADLINE:-30}" \
    --mode "${OUSAST_PUSH_MODE:-advisory}" \
    --incomplete-coverage "${OUSAST_INCOMPLETE_COVERAGE:-allow}" \
    --engine "${OUSAST_PUSH_ENGINE:-inline}"
if [ -n "${OUSAST_COMPARISON_BASE:-}" ]; then
    set -- "$@" --comparison-base "$OUSAST_COMPARISON_BASE"
fi
if [ -e "$prior" ] || [ -L "$prior" ]; then
    set -- "$@" --prior-hook "$prior"
fi
exec "$command" "$@" --remote "$remote_name" "$remote_url"
