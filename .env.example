# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=

# Prove-budget and `ousast index` embeddings via OpenRouter /embeddings.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Any OpenAI-compatible chat endpoint works for the hunter: set the key above to that
# provider's key and override the base URL. Example for DeepSeek:
#   OPENROUTER_API_KEY=sk-deepseek-...
#   OPENROUTER_BASE_URL=https://api.deepseek.com/v1
# Then set [models].hunter in openultrasast.toml (or --hunter-model) to that provider's model id.
OPENROUTER_BASE_URL=
